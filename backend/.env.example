# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key# Server-side only. NEVER put this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key# OPTIONAL. Legacy JWT secret enables a faster local token check. Leave blank to verify via Supabase Auth
# (works for every project, including ones using the newer asymmetric signing keys).
SUPABASE_JWT_SECRET=

# ---- Gemini (https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=your-gemini-api-keyGEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=30
